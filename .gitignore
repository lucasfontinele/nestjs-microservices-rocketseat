# ==============================================================
# Monorepo de microserviços Node/NestJS
# Padrões sem "/" no início valem em qualquer pasta (cada serviço)
# ==============================================================

# --- Dependências ---
node_modules/
jspm_packages/
.pnpm-store/

# Yarn Berry (mantém o que deve ser versionado)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# --- Build ---
dist/
build/
out/
*.tsbuildinfo

# --- Cache de ferramentas de monorepo ---
.turbo/
.nx/cache/
.nx/workspace-data/

# --- Testes e cobertura ---
coverage/
.nyc_output/
junit.xml
reports/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Relatórios de diagnóstico do Node
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# --- Variáveis de ambiente (nunca versionar segredos) ---
.env
.env.*
!.env.example
!.env.sample
!.env.template

# --- Segredos e certificados ---
*.pem
*.key
*.p12
*.pfx

# --- Caches diversos ---
.cache/
.npm/
.eslintcache
.stylelintcache

# --- Temporários e runtime ---
tmp/
temp/
.tmp/
.temp/
pids/
*.pid
*.pid.lock
*.seed

# --- IDEs ---
.idea/
*.iml
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# --- Sistema operacional ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Docker (descomente se usar override local) ---
# docker-compose.override.yml